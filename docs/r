@echo off
setlocal EnableExtensions
rem Rescue Support launcher. Source: https://github.com/crossainthero-lab/fix
rem Downloads rescue.ps1, checks its SHA-256 against the value below, then runs it with Windows PowerShell.
rem Usage:  r.cmd CODE | r.cmd | r.cmd status | r.cmd check | r.cmd uninstall   (CODE = one-time code from the helper)
set "BASE=https://crossainthero-lab.github.io/fix"
set "WANT=2970b22c16cd9cf850233750098f2806d248e8f76cf005e792b1e237f90faa8e"
set "D=%ProgramData%\RescueSupport"
set "ARGS=%*"
set "PS=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
if defined PROCESSOR_ARCHITEW6432 set "PS=%SystemRoot%\Sysnative\WindowsPowerShell\v1.0\powershell.exe"
if not exist "%PS%" (
  echo  Windows PowerShell was not found at "%PS%".
  exit /b 11
)

net session >nul 2>&1
if errorlevel 1 (
  if defined RESCUE_ELEVATING (
    echo.
    echo  Administrator rights were not granted, so nothing was changed.
    exit /b 10
  )
  echo.
  echo  Administrator rights are needed. A Windows permission prompt is about to appear.
  echo  Choose YES. With the keyboard only: press Alt+Y, or press the Left Arrow key and then Enter.
  echo  A new window will open and continue there.
  set "RS_SELF=%~f0"
  set "RS_ARGS=%*"
  set "RESCUE_ELEVATING=1"
  > "%TEMP%\rs-elev.ps1" echo $a='/k ""' + $env:RS_SELF + '" ' + $env:RS_ARGS + '"'
  >> "%TEMP%\rs-elev.ps1" echo Start-Process -Verb RunAs -FilePath cmd.exe -ArgumentList $a
  "%PS%" -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\rs-elev.ps1"
  if errorlevel 1 (
    del "%TEMP%\rs-elev.ps1" >nul 2>&1
    echo.
    echo  The permission prompt was declined or could not be shown, so nothing was changed.
    exit /b 10
  )
  del "%TEMP%\rs-elev.ps1" >nul 2>&1
  exit /b 0
)

if not exist "%D%" mkdir "%D%"
rem Only SYSTEM and Administrators may write here, so nobody can swap the script between check and run.
icacls "%D%" /inheritance:r /grant:r "*S-1-5-32-544:(OI)(CI)F" "*S-1-5-18:(OI)(CI)F" >nul 2>&1

echo.
echo  Rescue Support - downloading installer script...
curl.exe -fsSL --proto =https --retry 3 --connect-timeout 20 -H "Cache-Control: no-cache" "%BASE%/rescue.ps1" -o "%D%\rescue.ps1.new"
if errorlevel 1 (
  echo.
  echo  DOWNLOAD FAILED. Check the internet connection and the date and time on this PC, then try again.
  del "%D%\rescue.ps1.new" >nul 2>&1
  exit /b 1
)

"%PS%" -NoProfile -Command "$h=(Get-FileHash -Algorithm SHA256 -LiteralPath '%D%\rescue.ps1.new').Hash.ToLower(); if ($h -eq '%WANT%') { exit 0 } else { Write-Host ('   received ' + $h); exit 1 }"
if errorlevel 1 (
  echo.
  echo  SECURITY CHECK FAILED - the downloaded script does not match the expected fingerprint, or could not be checked.
  echo    expected %WANT%
  echo  Nothing was run. If the link was updated minutes ago, wait ten minutes for the web cache to refresh and try again.
  del "%D%\rescue.ps1.new" >nul 2>&1
  exit /b 2
)
move /y "%D%\rescue.ps1.new" "%D%\rescue.ps1" >nul
echo  Fingerprint verified: SHA-256 %WANT:~0,16%...

"%PS%" -NoProfile -ExecutionPolicy Bypass -File "%D%\rescue.ps1" %ARGS%
set "RC=%ERRORLEVEL%"
echo.
if "%RC%"=="0" (echo  Finished OK.) else if "%RC%"=="3010" (echo  Finished - a Windows restart is required.) else (echo  Finished with code %RC%.)
exit /b %RC%
